{
  "name": "flowaccount-instagram-reel",
  "version": "1.0.0",
  "description": "FlowAccount 30-second Instagram Reel (1080x1920) — energetic motion graphics",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render FlowAccountReel out/FlowAccountReel.mp4 --codec=h264",
    "render": "remotion render FlowAccountReel out/FlowAccountReel.mp4 --codec=h264 --crf=18",
    "still": "remotion still FlowAccountReel --frame=0 out/preview.png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "remotion": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "typescript": "5.4.5"
  },
  "remotion": {
    "entrypoint": "src/index.ts"
  }
}
